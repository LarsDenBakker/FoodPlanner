# Copy this file to .env and fill in the values below.
#
# Matches the docker-compose.yml Postgres service by default — after
# `docker compose up -d`, this connection string works as-is.
DATABASE_URL="postgresql://foodhelper:foodhelper@localhost:5432/foodhelper_dev?schema=public"

# Signs the login session cookie (jose/JWT). Generate with `openssl rand -base64 32`.
SESSION_SECRET=""

# Credentials for the initial household user created by prisma/seed.ts.
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me-please"
